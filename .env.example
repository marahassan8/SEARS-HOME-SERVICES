DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/shs_voice
BASE_URL=http://localhost:8000
PUBLIC_BASE_URL=http://localhost:8000
STT_PROVIDER=twilio
TTS_PROVIDER=twilio
TWILIO_VOICE=alice
TWILIO_SPEECH_MODEL=phone_call
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o-mini
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Must be a full mailbox: name@yourdomain.com (not a bare hostname like xxx.mlsender.net)
SMTP_FROM_EMAIL=no-reply@shs.local
# Optional: SMS a typing link (Twilio number that can send SMS, not the caller's number)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
